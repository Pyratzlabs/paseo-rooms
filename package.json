{
  "name": "paseo-rooms",
  "version": "0.1.0",
  "private": true,
  "description": "PoC: share a Paseo coding-agent session with a collaborator via a capability URL",
  "type": "module",
  "scripts": {
    "start": "npm run build:web && tsx src/server.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "share": "tsx scripts/share.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:relay": "tsx scripts/e2e-relay.ts",
    "typecheck": "tsc --noEmit",
    "relay": "tsx src/relay/relay.ts",
    "test:relay": "node --import tsx --test scripts/relay-protocol.test.ts",
    "test:room-ui": "node --test scripts/room-ui.test.mjs",
    "test:questions": "node --import tsx --test scripts/questions.test.ts",
    "test:public-events": "node --import tsx --test scripts/public-events.test.ts",
    "test:ci": "node --test scripts/ci-config.test.mjs",
    "test:lock": "node --test scripts/package-lock.test.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6"
  }
}
