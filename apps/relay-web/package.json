{
  "name": "@paseo-rooms/relay-web",
  "version": "0.1.0",
  "private": true,
  "description": "Paseo Rooms local room server, public relay, and shared web UI",
  "type": "module",
  "scripts": {
    "start": "npm --prefix ../docs run build && npm run build:web && tsx src/server-cli.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "format": "prettier --write eslint.config.js package.json scripts/ci-config.test.mjs scripts/markdown.test.mjs scripts/relay-origin.test.ts web",
    "format:check": "prettier --check eslint.config.js package.json scripts/ci-config.test.mjs scripts/markdown.test.mjs scripts/relay-origin.test.ts web",
    "lint": "eslint web eslint.config.js",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "share": "tsx scripts/share.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:relay": "tsx scripts/e2e-relay.ts",
    "typecheck": "tsc --noEmit",
    "relay": "tsx src/relay/relay.ts",
    "test:relay": "node --import tsx --test scripts/relay-protocol.test.ts",
    "test:local-server": "node --import tsx --test scripts/local-server-lifecycle.test.ts",
    "test:relay-client": "node --import tsx --test scripts/relay-client.test.ts scripts/relay-outbound.test.ts",
    "test:e2ee": "node --import tsx --test scripts/paseo-e2ee.test.ts scripts/secure-room.test.ts scripts/room-attachments.test.ts",
    "test:secure-client": "node --import tsx --test scripts/secure-room-client.test.ts",
    "test:relay-origin": "node --import tsx --test scripts/relay-origin.test.ts",
    "test:relay-target": "node --import tsx --test scripts/relay-target.test.ts",
    "test:e2ee-browser": "PASEO_E2EE_SMOKE=1 vite build --config web/vite.config.ts && node --test scripts/e2ee-browser-build.test.mjs",
    "test:name": "node --import tsx --test scripts/name.test.ts",
    "test:scroll": "node --import tsx --test scripts/scroll.test.ts",
    "test:room-ui": "node --test scripts/room-ui.test.mjs scripts/markdown.test.mjs",
    "test:timeline": "node --import tsx --test scripts/timeline.test.ts",
    "test:questions": "node --import tsx --test scripts/questions.test.ts && node --test scripts/paseo-client.test.mjs",
    "test:public-events": "node --import tsx --test scripts/public-events.test.ts",
    "test:presence": "node --import tsx --test scripts/presence.test.ts",
    "test:ci": "node --test scripts/ci-config.test.mjs",
    "test:lock": "node --test scripts/package-lock.test.mjs",
    "test:relay-access": "node --import tsx --test scripts/relay-access.test.ts scripts/relay-host-access.test.ts scripts/relay-policy.test.ts"
  },
  "dependencies": {
    "@getpaseo/client": "0.12.0",
    "@getpaseo/relay": "0.12.0",
    "dompurify": "3.4.16",
    "mermaid": "12.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  }
}
