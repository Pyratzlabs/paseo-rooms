# Builds the public relay and its already-built static presentation. The room
# server and daemon stay on developers' laptops; this image owns the landing
# page and shared-room React bundle, then relays dynamic room traffic.

FROM node:22-alpine

WORKDIR /app

# A trimmed package.json/lockfile-free install: only the relay's runtime
# dependency (ws) and tsx to run the TypeScript source directly, so we avoid
# a separate build stage while keeping the image small.
RUN printf '%s\n' \
  '{' \
  '  "name": "paseo-rooms-relay",' \
  '  "version": "0.1.0",' \
  '  "private": true,' \
  '  "type": "module",' \
  '  "dependencies": {' \
  '    "ws": "^8.18.0"' \
  '  },' \
  '  "devDependencies": {' \
  '    "tsx": "^4.19.0"' \
  '  }' \
  '}' > package.json

RUN npm install --no-audit --no-fund && npm cache clean --force

# CI builds Vite before deploy and rsyncs the resulting public directory. The
# relay image serves those files directly, so browsers never fetch UI assets
# from a developer laptop.
COPY src/relay ./src/relay
COPY public ./public

ENV NODE_ENV=production
EXPOSE 8080

CMD ["npx", "tsx", "src/relay/relay.ts"]
