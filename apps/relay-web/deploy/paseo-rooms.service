# Example systemd USER unit for the laptop room server (NOT deployed to the
# VPS — the room server and Paseo daemon stay on developers' laptops; see
# docs/plan.md). Runs `npm start` in a local checkout with RELAY_URL/RELAY_KEY
# supplied via an EnvironmentFile, so the room server dials out to the relay
# instead of (or in addition to) listening locally.
#
# Install (as your normal user, not root):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/paseo-rooms.service ~/.config/systemd/user/
#   # edit WorkingDirectory below to your checkout path
#   printf 'RELAY_URL=wss://rooms.example.com/host\nRELAY_KEY=<shared secret>\n' \
#     > ~/.config/paseo-rooms.env
#   chmod 600 ~/.config/paseo-rooms.env
#   systemctl --user daemon-reload
#   systemctl --user enable --now paseo-rooms.service
#   systemctl --user status paseo-rooms.service
#
# (Optional) keep it running after logout / across reboots without a login:
#   loginctl enable-linger "$USER"

[Unit]
Description=paseo-rooms room server (dials out to relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/paseo-rooms/apps/relay-web
EnvironmentFile=%h/.config/paseo-rooms.env
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
